<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cognifyz | Expert Telemetry Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>body { background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); min-height: 100vh; color: #f8fafc; }</style>
</head>
<body class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold text-info">Cognifyz Advanced API Console</h1>
            <p class="text-secondary text-uppercase tracking-wider m-0">Level 4 - Task 7: Third-Party External Stream Synchronization</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger shadow border-0 mb-4"><%= error %></div>
        <% } %>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card bg-dark text-white p-4 rounded-4 border-secondary shadow-lg h-100">
                    <h5 class="fw-bold mb-3 text-info">📡 Coordinate Engine</h5>
                    <p class="small text-secondary">Query live telemetry channels across global third-party API coordinate nodes.</p>
                    <form id="coordForm" onsubmit="queryExternalData(event)">
                        <div class="mb-3">
                            <label class="form-label small text-secondary fw-semibold">Target Latitude Parameter</label>
                            <input type="text" id="latInput" class="form-control bg-secondary text-white border-0 font-monospace" value="17.6868" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small text-secondary fw-semibold">Target Longitude Parameter</label>
                            <input type="text" id="lonInput" class="form-control bg-secondary text-white border-0 font-monospace" value="83.2185" required>
                        </div>
                        <button type="submit" class="btn btn-info w-100 py-2 fw-bold text-dark mb-2">Fetch External Metrics</button>
                        <a href="/trigger-fault" class="btn btn-outline-danger w-100 btn-sm py-1.5 fw-semibold mt-2">Simulate 500 Server Error</a>
                    </form>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card bg-dark text-white p-4 rounded-4 border-secondary shadow-lg h-100">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-info m-0">📊 Real-Time Node Output</h5>
                        <span class="badge bg-success py-2 px-3 shadow-sm font-monospace">API Node Secure</span>
                    </div>
                    
                    <div id="loadingIndicator" class="text-center py-5 d-none">
                        <div class="spinner-border text-info" role="status"></div>
                        <p class="text-secondary mt-2 small">Calling external API registers...</p>
                    </div>

                    <div id="metricsDisplay">
                        <% if (weatherData && weatherData.current) { %>
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="p-3 bg-secondary bg-opacity-25 rounded-3 border border-secondary text-center">
                                        <small class="text-secondary d-block text-uppercase small">Ambient Temperature</small>
                                        <span class="display-6 fw-bold text-white" id="tempText"><%= weatherData.current.temperature_2m %>°C</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-secondary bg-opacity-25 rounded-3 border border-secondary text-center">
                                        <small class="text-secondary d-block text-uppercase small">Thermal Index (Feels Like)</small>
                                        <span class="display-6 fw-bold text-white" id="feelsText"><%= weatherData.current.apparent_temperature %>°C</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-secondary bg-opacity-25 rounded-3 border border-secondary text-center">
                                        <small class="text-secondary d-block text-uppercase small">Relative Humidity</small>
                                        <span class="display-6 fw-bold text-white" id="humidityText"><%= weatherData.current.relative_humidity_2m %>%</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 bg-secondary bg-opacity-25 rounded-3 border border-secondary text-center">
                                        <small class="text-secondary d-block text-uppercase small">Wind Velocity Mapping</small>
                                        <span class="display-6 fw-bold text-white" id="windText"><%= weatherData.current.wind_speed_10m %> km/h</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4 p-2 bg-black bg-opacity-50 rounded text-center">
                                <small class="text-muted font-monospace small">Data Sync Reference Frame: <%= weatherData.timezone %></small>
                            </div>
                        <% } else { %>
                            <p class="text-muted text-center py-5">No tracking datasets pulled from endpoint infrastructure channels.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function queryExternalData(e) {
            e.preventDefault();
            const lat = document.getElementById('latInput').value;
            const lon = document.getElementById('lonInput').value;
            
            const display = document.getElementById('metricsDisplay');
            const loader = document.getElementById('loadingIndicator');

            display.classList.add('d-none');
            loader.classList.remove('d-none');

            try {
                // Fetch internal proxy server route which communicates with external APIs and implements rate limiting
                const pipe = await fetch(`/api/telemetry?lat=${lat}&lon=${lon}`, {
                    headers: { 'Accept': 'application/json' }
                });
                
                const output = await pipe.json();
                loader.classList.add('d-none');
                display.classList.remove('d-none');

                if (!output.success) {
                    alert(`Rate Limit Warning / Error: ${output.error}`);
                    return;
                }

                const current = output.data.current;
                document.getElementById('tempText').innerText = `${current.temperature_2m}°C`;
                document.getElementById('feelsText').innerText = `${current.apparent_temperature}°C`;
                document.getElementById('humidityText').innerText = `${current.relative_humidity_2m}%`;
                document.getElementById('windText').innerText = `${current.wind_speed_10m} km/h`;

            } catch (err) {
                loader.classList.add('d-none');
                display.classList.remove('d-none');
                alert("Network communication error accessing target endpoints.");
            }
        }
    </script>
</body>
</html>